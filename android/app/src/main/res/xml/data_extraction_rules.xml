<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing EchoGesture keeps (conversations, taught signs, learning progress, settings) leaves the phone: no cloud
     backup and no copying to a new device. Android 12 and later read these rules; older versions read
     android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
