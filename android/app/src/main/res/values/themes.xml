<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#000000</color>

    <!-- The app is always dark: the window is ink before Compose draws, so nothing flashes grey. -->
    <style name="Theme.EchoGesture" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
    </style>

    <!-- Launch: the icon on ink while the app starts and its settings are read (MainActivity keeps it until then). -->
    <style name="Theme.EchoGesture.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.EchoGesture</item>
    </style>
</resources>
