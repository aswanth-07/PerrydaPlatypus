# Datasets (about 76 GB) and training runs stay local; anchored so android/.../data/ is not caught
/data/
/runs/
*.zip
*.pt
*.onnx
# The EchoGesture INT8 models ship with the source (src/models for predict(), android/models for the app's live captions)
!android/models/*.onnx
!src/models/*.onnx
*.tflite
*.npz
__pycache__/
android/**/build/
android/.gradle/
android/local.properties
# Release signing: the upload key and its passwords never go into Git (app/build.gradle.kts reads them if present)
android/keystore.properties
*.jks
*.keystore
# Generated before every build from src/models and android/models (app/build.gradle.kts, copyModels)
android/app/src/main/assets/
