# Datasets (about 76 GB) and training runs stay local; anchored so android/.../data/ is not caught
/data/
/runs/
*.zip
*.pt
*.onnx
# The INT8 models the app and the parity test load ship with the source
!android/app/src/main/assets/**/*.onnx
!android/parity/*.onnx
!android/models/**/*.onnx
!src/models/**/*.onnx
*.tflite
*.npz
__pycache__/
android/**/build/
android/.gradle/
android/local.properties
